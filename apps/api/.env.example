# Copy to .env (git-ignored). Everything here is optional for local dev.

# Muse Spark turns on the AI features (crew reasons, plan polls, level-up nudges, interest tagging).
# Leave MUSE_API_KEY empty and the API uses template fallbacks, so the app still runs.
# Any OpenAI-compatible /chat/completions endpoint works; defaults are Eden AI's hosted Muse Spark.
MUSE_API_KEY=
MUSE_BASE_URL=https://api.edenai.run/v3
MUSE_MODEL=muse-spark-1.3

PORT=8787

# Local SQLite file by default. Point at a Turso database (libsql://...) to share one demo DB across the team.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=
