# Copy to .env (git-ignored). Everything here is optional for local dev.

# Meta Model API: https://dev.meta.ai/docs/quickstart
# Turns on First 20 ideas, crew reasons, plan polls, nudges, and interest tagging.
# Leave the key empty to use template fallbacks. MUSE_API_KEY remains a legacy alias.
MODEL_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3

PORT=8787

# Local SQLite file by default. Point at a Turso database (libsql://...) to share one demo DB across the team.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=
